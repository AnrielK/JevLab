// JevLab · Trend MA (stejná pravidla jako aplikace JevLab, záložka Horizont → Trend strategie)
//
// Signál na zavření svíčky:
//   long  = close > MA20 a close > MA50 a MA20 > MA20 před 5 svíčkami
//   short = close < MA20 a close < MA50 a MA20 < MA20 před 5 svíčkami
//   jinak žádný nový signál: otevřená pozice se drží max. N svíček (výchozí 5), pak se zavře.
// "Jen long": short signál pozici jen zavře.
// Obchod na zavírací ceně signální svíčky, pozice $1000, poplatek 0,045 % na stranu (Hyperliquid taker).
//
// Rozdíly proti JevLabu jsou malé a očekávané: TradingView drží pevný počet coinů (JevLab stálou hodnotu
// pozice $1000 každou svíčku) a data jiné burzy se mírně liší od Hyperliquid. Data a časy vstupů by měly sedět.
// Papírový test, ne doporučení k obchodu.

//@version=6
strategy("JevLab Trend MA", overlay = true, initial_capital = 10000,
     default_qty_type = strategy.cash, default_qty_value = 1000,
     commission_type = strategy.commission.percent, commission_value = 0.045,
     process_orders_on_close = true, pyramiding = 0)

longOnly = input.bool(true, "Jen long")
holdBars = input.int(5, "Držet bez nového signálu (svíček)", minval = 1)

ma20 = ta.sma(close, 20)
ma50 = ta.sma(close, 50)
up   = close > ma20 and close > ma50 and ma20 > ma20[5]
down = close < ma20 and close < ma50 and ma20 < ma20[5]
sig  = up ? 1 : down ? -1 : 0

var int pos = 0
var int age = 0
if sig != 0
    pos := sig
    age := 0
else if pos != 0
    age += 1
    if age >= holdBars
        pos := 0

target = longOnly ? math.max(pos, 0) : pos

if target == 1 and strategy.position_size <= 0
    strategy.entry("Long", strategy.long)
else if target == -1 and strategy.position_size >= 0
    strategy.entry("Short", strategy.short)
else if target == 0 and strategy.position_size != 0
    strategy.close_all(comment = "Ven")

plot(ma20, "MA20", color = color.orange)
plot(ma50, "MA50", color = color.purple, linewidth = 2)
bgcolor(target == 1 ? color.new(color.green, 90) : target == -1 ? color.new(color.red, 90) : na)
